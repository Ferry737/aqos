    {
      "id": "db435398-8ca7-4b81-8dcf-a5bc7f98474c",
      "name": "Cycle summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4760,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Quiet by default: notify only on escalations or an unusual reject ratio.\nconst s = $input.first().json.r ?? {};\nconst total = Number(s.proposals ?? 0);\nconst rejected = Number(s.rejected ?? 0);\nconst ratio = total ? rejected / total : 0;\nconst notify = Number(s.escalations ?? 0) > 0 || (total >= 5 && ratio > 0.5);\nconst text = `[CYCLE] ${s.cycle_id}: ${total} proposals, ${s.approved ?? 0} approved, ${s.resized ?? 0} resized, `\n  + `${rejected} rejected, ${s.escalations ?? 0} escalations, ${s.orders_registered ?? 0} orders`;\nreturn [{ json: { ...s, reject_ratio: ratio, notify, severity: Number(s.escalations ?? 0) > 0 ? 'SEV2' : 'SEV3', text } }];\n"
      }
    },
    {
