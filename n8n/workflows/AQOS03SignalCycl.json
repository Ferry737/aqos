    {
      "id": "08d62c91-065e-40d0-89a8-e1945457c1bb",
      "name": "Fan out proposals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3920,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One item per proposal, shuffled every cycle so that no client is\n// systematically first when many accounts trade the same signal. Strategy\n// capacity is shared pro-rata inside the gate regardless of order.\nconst props = [...($('Prepare cycle outputs').first().json.proposals ?? [])];\nfor (let i = props.length - 1; i > 0; i--) {\n  const j = Math.floor(Math.random() * (i + 1));\n  [props[i], props[j]] = [props[j], props[i]];\n}\nreturn props.map((p) => ({ json: p }));\n"
      }
    },
    {
      "id": "6a40dfb0-638b-4785-80a6-3ec543e317a9",
      "name": "Risk gate",
      "type": "n8n-nodes-base.executeWorkflow",
