    {
      "id": "6ee7fb25-d6cd-44a3-8166-ac9f5bc56b2b",
      "name": "Notable events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Alerting on execution events: liquidations and ADL page (SEV1), venue\n// rejects notify (SEV2), slippage outliers are logged to the ops channel (SEV3).\nconst r = $input.first().json.r ?? {};\nconst notable = Array.isArray(r.notable) ? r.notable : [];\nif (!notable.length) return [];\nconst severity = notable.some((n) => n.severity === 'SEV1') ? 'SEV1' : notable.some((n) => n.severity === 'SEV2') ? 'SEV2' : 'SEV3';\nconst lines = notable.slice(0, 20).map((n) => [\n  n.severity, n.kind, n.account_id, n.symbol, n.venue,\n  n.slippage_bps != null ? `${n.slippage_bps} bps` : null, n.reason,\n].filter(Boolean).join(' '));\nreturn [{\n  json: {\n    severity,\n    count: notable.length,\n    text: `[${severity}] Execution events: ${notable.length} notable\\n${lines.join('\\n')}`,\n    dedup_key: `exec-${severity}-${new Date().toISOString().slice(0, 13)}`,\n  },\n}];\n"
      }
    },
    {
      "id": "e1678eb0-9e76-4784-8843-6a7bb1801952",
      "name": "Reconcile every 5 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        150
      ],
      "parameters": {
