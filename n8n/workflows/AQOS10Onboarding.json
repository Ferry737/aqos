    {
      "id": "6256dda2-c0c3-44a2-837b-2c2570f9fe74",
      "name": "Screening outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        150
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Maps the sanctions/PEP screening result onto the client record. A hit is\n// never explained to the applicant (no tipping off); compliance reviews it.\nconst v = $('Validate signup').first().json;\nconst res = $input.first().json;\nconst result = String(res.result ?? (res.error ? 'ERROR' : 'REVIEW')).toUpperCase();\nconst status = { CLEAR: 'ACTIVE', REVIEW: 'PENDING_REVIEW', HIT: 'BLOCKED' }[result] ?? 'PENDING_REVIEW';\nreturn [{\n  json: {\n    route: status,\n    create: { ...v.client, status, screening: { provider_ref: res.reference ?? null, result, checked_at: new Date().toISOString() } },\n    email: v.client.email,\n  },\n}];\n"
      }
    },
