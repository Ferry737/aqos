# Copy to deploy/.env and fill in. Never commit the real file.
POSTGRES_DB=aqos
POSTGRES_USER=aqos
POSTGRES_PASSWORD=change-me-long-random
# 32+ random characters; losing it makes stored credentials unreadable.
N8N_ENCRYPTION_KEY=change-me-long-random
# Public HTTPS URL that the stream gateway, EMS, Stripe and the client portal call.
N8N_PUBLIC_URL=https://n8n.example.com/
